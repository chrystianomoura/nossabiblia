{
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "name": "nossabiblia",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "node --test \"server/**/*.test.js\" \"client/src/**/*.test.js\"",
    "clean:text": "node server/scripts/clean-verse-text.mjs",
    "test:accuracy": "node --test \"server/accuracy/*.accuracy.js\""
  }
